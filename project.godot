; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="MicroJam Fishing"
run/main_scene="uid://b8ldt1a84ofj4"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Conductor="*uid://c3w8a3u78gho0"
ItemExchange="*uid://cijrkpp58a3bx"
SceneSwitching="*uid://dsdn8fwyha7x4"
Dialogic="*uid://ds2q0uclmolvu"
Enigma="*uid://d0yrislsdvpsh"

[dialogic]

directories/dch_directory={
"anemon": "res://dialogic/anemon.dch",
"brochette": "res://dialogic/brochette.dch",
"joe": "res://dialogic/joe.dch",
"latern": "res://dialogic/latern.dch",
"pirhana": "res://dialogic/pirhana.dch",
"sharko": "res://dialogic/sharko.dch",
"swordfish": "res://dialogic/swordfish.dch",
"whale": "res://dialogic/whale.dch"
}
directories/dtl_directory={
"arrival": "res://dialogic/arrival.dtl",
"meeting_couple": "res://dialogic/meeting_couple.dtl",
"meeting_lantern": "res://dialogic/meeting_lantern.dtl",
"meeting_swordfish": "res://dialogic/meeting_swordfish.dtl",
"meeting_whale": "res://dialogic/meeting_whale.dtl",
"nothing_whale": "res://dialogic/nothing_whale.dtl",
"table_disabled": "res://dialogic/table_disabled.dtl",
"table_success": "res://dialogic/table_success.dtl",
"test_timeline": "res://dialogic/test_timeline.dtl"
}
layout/style_directory={}
glossary/default_case_sensitive=true
variables={
"NextDialogue": {
"couple": "meeting_couple",
"lantern": "meeting_lantern",
"sharko": "meeting_sharko",
"swordfish": "meeting_swordfish",
"whale": "arrival"
},
"table_puzzle_enabled": false
}
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}
layout/style_list=[]
layout/default_style=""

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg")

